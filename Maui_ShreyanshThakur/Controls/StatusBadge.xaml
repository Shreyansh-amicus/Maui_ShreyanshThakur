<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui_ShreyanshThakur.Controls.StatusBadge"
    x:Name="Root">

    <Border
        x:Name="BadgeBorder"
        Padding="{StaticResource StatusBadgePadding}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20"
        BackgroundColor="{StaticResource StatusPendingBackgroundColor}">

        <Label
            x:Name="BadgeLabel"
            Text="{Binding Status, Source={x:Reference Root}}"
            FontFamily="PoppinsSemiBold"
            FontSize="{StaticResource StatusBadgeFontSize}"
            TextColor="{StaticResource StatusPendingTextColor}"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

    </Border>

</ContentView>
