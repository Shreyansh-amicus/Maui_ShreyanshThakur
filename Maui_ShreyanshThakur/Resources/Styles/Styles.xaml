<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base style for labels -->
    <Style
        x:Key="DefaultLabelStyle"
        TargetType="Label">

        <Setter
            Property="FontSize"
            Value="{StaticResource BodyFontSize}" />

        <Setter
            Property="TextColor"
            Value="{StaticResource PrimaryTextColor}" />

    </Style>

    <!-- Implicit Label style -->
    <Style
        TargetType="Label"
        BasedOn="{StaticResource DefaultLabelStyle}" />

    <!-- Explicit style: Page title -->
    <Style
        x:Key="PageTitleStyle"
        TargetType="Label"
        BasedOn="{StaticResource DefaultLabelStyle}">

        <Setter
            Property="FontSize"
            Value="{StaticResource PageTitleSize}" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

    </Style>

    <!-- Explicit style: Profile name -->
    <Style
        x:Key="ProfileNameStyle"
        TargetType="Label"
        BasedOn="{StaticResource DefaultLabelStyle}">

        <Setter
            Property="FontSize"
            Value="{StaticResource ProfileNameSize}" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />

    </Style>

    <!-- Explicit style: Section heading -->
    <Style
        x:Key="SectionTitleStyle"
        TargetType="Label"
        BasedOn="{StaticResource DefaultLabelStyle}">

        <Setter
            Property="FontSize"
            Value="{StaticResource SectionTitleSize}" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

    </Style>

    <!-- Explicit style: Secondary information -->
    <Style
        x:Key="SecondaryTextStyle"
        TargetType="Label"
        BasedOn="{StaticResource DefaultLabelStyle}">

        <Setter
            Property="TextColor"
            Value="{StaticResource SecondaryTextColor}" />

    </Style>

    <!-- Explicit style: Accent text -->
    <Style
        x:Key="AccentTextStyle"
        TargetType="Label"
        BasedOn="{StaticResource DefaultLabelStyle}">

        <Setter
            Property="FontSize"
            Value="{StaticResource SubtitleSize}" />

        <Setter
            Property="TextColor"
            Value="{StaticResource AccentColor}" />

        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />

    </Style>

    <!-- Explicit style: Profile button -->
    <Style
        x:Key="PrimaryButtonStyle"
        TargetType="Button">

        <Setter
            Property="FontSize"
            Value="{StaticResource ButtonFontSize}" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="TextColor"
            Value="{StaticResource SurfaceColor}" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource AccentColor}" />

        <Setter
            Property="CornerRadius"
            Value="{StaticResource ButtonCornerRadius}" />

        <Setter
            Property="HeightRequest"
            Value="{StaticResource ButtonHeight}" />

        <Setter Property="FontFamily" Value="PoppinsRegular" />

    </Style>

</ResourceDictionary>
