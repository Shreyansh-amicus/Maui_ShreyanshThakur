<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Application backgrounds -->
    <Color x:Key="PageBackgroundColor">#F4F6F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <!-- Text colours -->
    <Color x:Key="PrimaryTextColor">#1F2937</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>

    <!-- Accent and borders -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="AvatarBorderColor">#D1D5DB</Color>

    <Color x:Key="HighPriorityColor">#DC2626</Color>
    <Color x:Key="MediumPriorityColor">#D97706</Color>
    <Color x:Key="LowPriorityColor">#059669</Color>

    <Color x:Key="PendingStatusBackgroundColor">#FEF3C7</Color>
    <Color x:Key="PendingStatusTextColor">#92400E</Color>

    <Color x:Key="InProgressStatusBackgroundColor">#DBEAFE</Color>
    <Color x:Key="InProgressStatusTextColor">#1D4ED8</Color>

    <Color x:Key="CompletedStatusBackgroundColor">#D1FAE5</Color>
    <Color x:Key="CompletedStatusTextColor">#047857</Color>

    <!-- Inspection List -->
    <Color x:Key="SelectedInspectionBackgroundColor">#DBEAFE</Color>

    <Color x:Key="PendingInspectionColor">#92400E</Color>
    <Color x:Key="PendingInspectionBackgroundColor">#FEF3C7</Color>

    <Color x:Key="InProgressInspectionColor">#1D4ED8</Color>
    <Color x:Key="InProgressInspectionBackgroundColor">#DBEAFE</Color>

    <Color x:Key="CompletedInspectionColor">#047857</Color>
    <Color x:Key="CompletedInspectionBackgroundColor">#D1FAE5</Color>

    <Color x:Key="TransparentColor">#00000000</Color>

    <!-- Dashboard specific colours -->

    <!-- Total inspection indicator -->
    <Color x:Key="DashboardTotalColor">
        #2563EB
    </Color>

    <!-- In Progress dashboard metric -->
    <Color x:Key="DashboardInProgressColor">
        #7C3AED
    </Color>

    <!-- High priority background -->
    <Color x:Key="HighPriorityBackgroundColor">
        #FEE2E2
    </Color>

    <!-- High priority text -->
    <Color x:Key="HighPriorityTextColor">
        #B91C1C
    </Color>

    <!-- Dashboard View All background -->
    <Color x:Key="DashboardViewAllBackgroundColor">
        #EFF6FF
    </Color>

    <!-- Dashboard time text -->
    <Color x:Key="DashboardTimeTextColor">
        #475569
    </Color>

    <!-- Inspection View Toggle -->
    <Color x:Key="InspectionViewSelectedBackgroundColor">#2563EB</Color>
    <Color x:Key="InspectionViewSelectedTextColor">#FFFFFF</Color>
    <Color x:Key="InspectionViewUnselectedBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InspectionViewUnselectedTextColor">#64748B</Color>

    <!-- Status Badge Colors -->

    <Color x:Key="StatusPendingBackgroundColor">#FFF3CD</Color>
    <Color x:Key="StatusPendingTextColor">#856404</Color>

    <Color x:Key="StatusInProgressBackgroundColor">#DBEAFE</Color>
    <Color x:Key="StatusInProgressTextColor">#1D4ED8</Color>

    <Color x:Key="StatusCompletedBackgroundColor">#D1FAE5</Color>
    <Color x:Key="StatusCompletedTextColor">#065F46</Color>

    <Color x:Key="ReusableCardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ReusableCardBorderColor">#E5E7EB</Color>
    <Color x:Key="InspectionListCardBorderColor">#011111</Color>
    <Color x:Key="InspectionListCardBackgroundColor">#EFF6FF</Color>

    <!-- Login Page Colors -->
    <Color x:Key="LoginHeadingColor">#263445</Color>
    <Color x:Key="LoginSecondaryTextColor">#64748B</Color>
    <Color x:Key="LoginFieldTextColor">#263445</Color>
    <Color x:Key="LoginPlaceholderColor">#94A3B8</Color>
    <Color x:Key="LoginEntryBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LoginEntryBorderColor">#CBD5E1</Color>
    <Color x:Key="LoginPrimaryColor">#2563EB</Color>
    <Color x:Key="LoginButtonTextColor">#FFFFFF</Color>
    <Color x:Key="LoginErrorColor">#DC2626</Color>

    <!-- Login Form Colors -->
    <Color x:Key="LoginFormCardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LoginFormCardBorderColor">#E2E8F0</Color>

    <Color x:Key="LoginFormHeadingColor">#1E293B</Color>
    <Color x:Key="LoginFormSubtitleColor">#64748B</Color>
    <Color x:Key="LoginFormFooterColor">#94A3B8</Color>

    <Color x:Key="LoginFormEntryBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LoginFormEntryBorderColor">#CBD5E1</Color>

    <Color x:Key="LoginFormButtonBackgroundColor">#2563EB</Color>
    <Color x:Key="LoginFormButtonTextColor">#FFFFFF</Color>


    <Color x:Key="LoginFormEntryTextColor">#334155</Color>
    <Color x:Key="LoginFormPlaceholderColor">#94A3B8</Color>



</ResourceDictionary>
