<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Application backgrounds -->
    <Color x:Key="PageBackgroundColor">#F4F6F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <!-- Text colours -->
    <Color x:Key="PrimaryTextColor">#1F2937</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>

    <!-- Accent and borders -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="AvatarBorderColor">#D1D5DB</Color>

</ResourceDictionary>
