<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui_ShreyanshThakur.InspectionListPage"
    Title="Inspections"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All">

    <Grid
        Padding="{StaticResource PagePadding}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{StaticResource InspectionListPageSpacing}">

        <!-- Page Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="{StaticResource InspectionListHeaderSpacing}">

            <Label
                Text="Inspections"
                Style="{StaticResource PageTitleStyle}" />

            <Label
                Text="View and manage scheduled inspections"
                Style="{StaticResource PageSubtitleStyle}" />

            <Label
                Text="{Binding InspectionCountText}"
                Style="{StaticResource InspectionListCountStyle}" />

        </VerticalStackLayout>

        <!-- View Toggle -->
        <Border
            Grid.Row="1"
            Style="{StaticResource InspectionViewToggleContainerStyle}">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="{StaticResource InspectionViewToggleSpacing}">

                <Button
                    x:Name="CollectionViewButton"
                    Grid.Column="0"
                    Text="Card View"
                    Clicked="OnCollectionViewClicked"
                    Style="{StaticResource InspectionViewSelectedButtonStyle}" />

                <Button
                    x:Name="ListViewButton"
                    Grid.Column="1"
                    Text="List View"
                    Clicked="OnListViewClicked"
                    Style="{StaticResource InspectionViewUnselectedButtonStyle}" />

            </Grid>

        </Border>

        <!-- Inspection Lists -->
        <Grid Grid.Row="2">

            <!-- CollectionView -->
            <CollectionView
                x:Name="InspectionCollection"
                ItemsSource="{Binding Inspections}"
                SelectionMode="Single"
                SelectionChanged="OnSelectionChanged">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="{StaticResource InspectionListItemSpacing}" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="No inspections found"
                            Style="{StaticResource EmptyStateTitleStyle}" />

                        <Label
                            Text="Your inspections will appear here."
                            Style="{StaticResource EmptyStateSubtitleStyle}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Style="{StaticResource InspectionListCardStyle}">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="{StaticResource InspectionListCardSpacing}">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Title}"
                                    Style="{StaticResource InspectionListTitleStyle}" />

                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                                    <Label
                                        Text="Site:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                    <Label
                                        Text="{Binding Site}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                </HorizontalStackLayout>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource InspectionListStatusBadgeStyle}">

                                    <Label
                                        Text="{Binding Status}"
                                        Style="{StaticResource InspectionListStatusTextStyle}" />

                                </Border>

                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                    <Label
                                        Text="Scheduled:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                    <Label
                                        Text="{Binding ScheduledDate,
                                            StringFormat='{0:dd MMM yyyy}'}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- ListView -->
            <ListView
                x:Name="InspectionList"
                ItemsSource="{Binding Inspections}"
                SelectionMode="Single"
                ItemSelected="OnItemSelected"
                IsVisible="False"
                SeparatorVisibility="None"
                HasUnevenRows="True"
                BackgroundColor="Transparent">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <ViewCell>

                            <Border
                                Style="{StaticResource InspectionListCardStyle}">

                                <Grid
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions="*,Auto"
                                    RowSpacing="{StaticResource InspectionListCardSpacing}">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding Title}"
                                        Style="{StaticResource InspectionListTitleStyle}" />

                                    <HorizontalStackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Spacing="6">

                                        <Label
                                            Text="Site:"
                                            Style="{StaticResource InspectionListMetaLabelStyle}" />

                                        <Label
                                            Text="{Binding Site}"
                                            Style="{StaticResource InspectionListMetaValueStyle}" />

                                    </HorizontalStackLayout>

                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource InspectionListStatusBadgeStyle}">

                                        <Label
                                            Text="{Binding Status}"
                                            Style="{StaticResource InspectionListStatusTextStyle}" />

                                    </Border>

                                    <HorizontalStackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Spacing="6">

                                        <Label
                                            Text="Scheduled:"
                                            Style="{StaticResource InspectionListMetaLabelStyle}" />

                                        <Label
                                            Text="{Binding ScheduledDate,
                                                StringFormat='{0:dd MMM yyyy}'}"
                                            Style="{StaticResource InspectionListMetaValueStyle}" />

                                    </HorizontalStackLayout>

                                </Grid>

                            </Border>

                        </ViewCell>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Grid>

    </Grid>

</ContentPage>