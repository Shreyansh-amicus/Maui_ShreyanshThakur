<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Maui_ShreyanshThakur.Controls"
    x:Class="Maui_ShreyanshThakur.InspectionListPage"
    Title="Inspections"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All">

    <Grid
        Padding="{StaticResource PagePadding}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{StaticResource InspectionListPageSpacing}">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="{StaticResource InspectionListHeaderSpacing}">

            <Label
                Text="{Binding InspectionCountText}"
                Style="{StaticResource InspectionListCountStyle}" />

        </VerticalStackLayout>

        <!-- View Toggle -->
        <Border
            Grid.Row="1"
            Style="{StaticResource InspectionViewToggleContainerStyle}">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="{StaticResource InspectionViewToggleSpacing}">

                <!-- Collection View Toggle -->
                <Grid Grid.Column="0">

                    <!-- Selected State -->
                    <Button
                        Text="Collection View"
                        Command="{Binding ShowCollectionViewCommand}"
                        IsVisible="{Binding IsCollectionViewSelected}"
                        Style="{StaticResource InspectionViewSelectedButtonStyle}" />

                    <!-- Unselected State -->
                    <Button
                        Text="Collection View"
                        Command="{Binding ShowCollectionViewCommand}"
                        IsVisible="{Binding IsListViewSelected}"
                        Style="{StaticResource InspectionViewUnselectedButtonStyle}" />

                </Grid>

                <!-- List View Toggle -->
                <Grid Grid.Column="1">

                    <!-- Selected State -->
                    <Button
                        Text="List View"
                        Command="{Binding ShowListViewCommand}"
                        IsVisible="{Binding IsListViewSelected}"
                        Style="{StaticResource InspectionViewSelectedButtonStyle}" />

                    <!-- Unselected State -->
                    <Button
                        Text="List View"
                        Command="{Binding ShowListViewCommand}"
                        IsVisible="{Binding IsCollectionViewSelected}"
                        Style="{StaticResource InspectionViewUnselectedButtonStyle}" />

                </Grid>

            </Grid>

        </Border>


        <!-- Inspection Display Area -->
        <Grid Grid.Row="2">

            <!-- Loading Indicator -->
            <VerticalStackLayout
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Label
                    Text="Loading inspections..."
                    HorizontalOptions="Center"
                    Style="{StaticResource InspectionListMetaValueStyle}" />

            </VerticalStackLayout>

            <!-- CollectionView -->
            <CollectionView
        ItemsSource="{Binding Inspections}"
        IsVisible="{Binding IsCollectionViewVisible}"
        SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="{StaticResource InspectionListItemSpacing}" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="No inspections found"
                            Style="{StaticResource EmptyStateTitleStyle}" />

                        <Label
                            Text="Your inspections will appear here."
                            Style="{StaticResource EmptyStateSubtitleStyle}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Style="{StaticResource InspectionListCardStyle}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InspectionSelectedCommand}"
                            CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="{StaticResource InspectionListCardSpacing}">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Title}"
                                    Style="{StaticResource InspectionListTitleStyle}" />

                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                                    <Label
                                        Text="Site:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                    <Label
                                        Text="{Binding SiteName}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                </HorizontalStackLayout>

                                <controls:StatusBadge
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Status="{Binding Status}" />

                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                    <Label
                                Text="Scheduled:"
                                Style="{StaticResource InspectionListMetaLabelStyle}" />

                                    <Label
                                Text="{Binding ScheduledOn, StringFormat='{0:dd MMM yyyy}'}"
                                Style="{StaticResource InspectionListMetaValueStyle}" />

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- ListView -->
            <ListView
                ItemsSource="{Binding Inspections}"
                IsVisible="{Binding IsListViewVisible}"
                SelectionMode="None"
                SeparatorVisibility="None"
                HasUnevenRows="True"
                BackgroundColor="Transparent">  

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <ViewCell>

                            <Grid
                        Padding="{StaticResource InspectionListViewItemSpacing}">

                                <Border
                            Style="{StaticResource InspectionListCardStyle}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InspectionSelectedCommand}"
                                    CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="{StaticResource InspectionListCardSpacing}">

                                        <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Title}"
                                    Style="{StaticResource InspectionListTitleStyle}" />

                                        <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                                            <Label
                                        Text="Site:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                            <Label
                                        Text="{Binding SiteName}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                        </HorizontalStackLayout>

                                        <controls:StatusBadge
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Status="{Binding Status}" />

                                        <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                            <Label
                                        Text="Scheduled:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                            <Label
                                        Text="{Binding ScheduledOn, StringFormat='{0:dd MMM yyyy}'}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                        </HorizontalStackLayout>

                                    </Grid>

                                </Border>

                            </Grid>

                        </ViewCell>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>


    </Grid>

</ContentPage>
