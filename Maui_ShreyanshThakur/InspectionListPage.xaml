<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Maui_ShreyanshThakur.Controls"
    xmlns:converters="clr-namespace:Maui_ShreyanshThakur.Converters"
    x:Class="Maui_ShreyanshThakur.InspectionListPage"
    Title="Inspections"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All">

    <!-- Page-level converter resources -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:StatusToColorConverter
                x:Key="StatusToColorConverter" />

            <converters:DateToRelativeTextConverter
                x:Key="DateToRelativeTextConverter" />

            <converters:InverseBooleanConverter
                x:Key="InverseBooleanConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    
        <Grid
        Padding="{StaticResource PagePadding}"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="{StaticResource InspectionListPageSpacing}">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="{StaticResource InspectionListHeaderSpacing}">

            <Label
                Text="{Binding InspectionCountText}"
                Style="{StaticResource InspectionListCountStyle}" />

            <HorizontalStackLayout Spacing="10">

                <Button
                    Text="New Inspection"
                    Clicked="OnNewInspectionClicked" />

                <Button
                    Text="Refresh"
                    Command="{Binding LoadInspectionsCommand}" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Search -->
        <Entry
            Grid.Row="1"
            Placeholder="Search by title, site, status, priority..."
            Text="{Binding SearchText, Mode=TwoWay}"
            ClearButtonVisibility="WhileEditing"
            ReturnType="Search" />

        <!-- View Toggle -->
        <Border
            Grid.Row="2"
            Style="{StaticResource InspectionViewToggleContainerStyle}">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="{StaticResource InspectionViewToggleSpacing}">

                <!-- CollectionView Toggle -->
                <Grid Grid.Column="0">

                    <Button
                        Text="Collection View"
                        Command="{Binding ShowCollectionViewCommand}"
                        IsVisible="{Binding IsCollectionViewSelected}"
                        Style="{StaticResource InspectionViewSelectedButtonStyle}" />

                    <Button
                        Text="Collection View"
                        Command="{Binding ShowCollectionViewCommand}"
                        IsVisible="{Binding IsListViewSelected}"
                        Style="{StaticResource InspectionViewUnselectedButtonStyle}" />

                </Grid>

                <!-- ListView Toggle -->
                <Grid Grid.Column="1">

                    <Button
                        Text="List View"
                        Command="{Binding ShowListViewCommand}"
                        IsVisible="{Binding IsListViewSelected}"
                        Style="{StaticResource InspectionViewSelectedButtonStyle}" />

                    <Button
                        Text="List View"
                        Command="{Binding ShowListViewCommand}"
                        IsVisible="{Binding IsCollectionViewSelected}"
                        Style="{StaticResource InspectionViewUnselectedButtonStyle}" />

                </Grid>

            </Grid>

        </Border>
        <RefreshView
            Command="{Binding LoadInspectionsCommand}"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
            Grid.Row="3">
            <!-- Inspection Display Area -->
            <Grid>

            <!-- Loading Indicator -->
            <VerticalStackLayout
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Label
                    Text="Loading inspections..."
                    HorizontalOptions="Center"
                    Style="{StaticResource InspectionListMetaValueStyle}" />

            </VerticalStackLayout>

            <!-- CollectionView -->
            <CollectionView
                ItemsSource="{Binding Inspections}"
                IsVisible="{Binding IsCollectionViewVisible}"
                SelectionMode="Single"
                SelectionChanged="OnInspectionSelectionChanged">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="{StaticResource InspectionListItemSpacing}" />
                </CollectionView.ItemsLayout>

                <!-- Empty State -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10"
                        IsVisible="{Binding HasInspections,
                            Converter={StaticResource InverseBooleanConverter}}">

                        <Label
                            Text="No inspections found"
                            Style="{StaticResource EmptyStateTitleStyle}" />

                        <Label
                            Text="Try changing your search or clearing it."
                            Style="{StaticResource EmptyStateSubtitleStyle}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- CollectionView Item Template -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Style="{StaticResource InspectionListCardStyle}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InspectionSelectedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="{StaticResource InspectionListCardSpacing}">

                                <!-- Title -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Title}"
                                    Style="{StaticResource InspectionListTitleStyle}" />

                                <!-- Site -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                                    <Label
                                        Text="Site:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                    <Label
                                        Text="{Binding SiteName}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                </HorizontalStackLayout>

                                <!-- Status -->
                                <controls:StatusBadge
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Status="{Binding Status}" />

                                <!-- Scheduled Date -->
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                    <Label
                                        Text="Scheduled:"
                                        Style="{StaticResource InspectionListMetaLabelStyle}" />

                                    <Label
                                        Text="{Binding ScheduledOn,
                                            Converter={StaticResource DateToRelativeTextConverter}}"
                                        Style="{StaticResource InspectionListMetaValueStyle}" />

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- ListView -->
            <ListView
                ItemsSource="{Binding Inspections}"
                IsVisible="{Binding IsListViewVisible}"
                SelectionMode="None"
                SeparatorVisibility="None"
                HasUnevenRows="True"
                BackgroundColor="Transparent">

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <ViewCell>

                            <Grid
                                Padding="{StaticResource InspectionListViewItemSpacing}">

                                <Border
                                    Style="{StaticResource InspectionListCardStyle}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InspectionSelectedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto"
                                        ColumnDefinitions="*,Auto"
                                        RowSpacing="{StaticResource InspectionListCardSpacing}">

                                        <!-- Title -->
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding Title}"
                                            Style="{StaticResource InspectionListTitleStyle}" />

                                        <!-- Site -->
                                        <HorizontalStackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Spacing="6">

                                            <Label
                                                Text="Site:"
                                                Style="{StaticResource InspectionListMetaLabelStyle}" />

                                            <Label
                                                Text="{Binding SiteName}"
                                                Style="{StaticResource InspectionListMetaValueStyle}" />

                                        </HorizontalStackLayout>

                                        <!-- Status -->
                                        <!-- Status -->
                                        <controls:StatusBadge
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Status="{Binding Status}" />

                                        <!-- Scheduled Date -->
                                        <HorizontalStackLayout
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Spacing="6">

                                            <Label
                                                Text="Scheduled:"
                                                Style="{StaticResource InspectionListMetaLabelStyle}" />

                                            <Label
                                                Text="{Binding ScheduledOn,
                                                    Converter={StaticResource DateToRelativeTextConverter}}"
                                                Style="{StaticResource InspectionListMetaValueStyle}" />

                                        </HorizontalStackLayout>

                                    </Grid>

                                </Border>

                            </Grid>

                        </ViewCell>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>
        </RefreshView>

    </Grid>
    
</ContentPage>
