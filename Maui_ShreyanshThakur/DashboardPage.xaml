<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui_ShreyanshThakur.DashboardPage"
    Title="Dashboard"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All">

    <ScrollView>

        <VerticalStackLayout
            Padding="{StaticResource DashboardPagePadding}"
            Spacing="{StaticResource DashboardPageSpacing}">

            <!-- ================= HEADER ================= -->

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout
                    Spacing="{StaticResource DashboardHeaderSpacing}"
                    VerticalOptions="Center">

                    <Label
                        Text="Dashboard"
                        Style="{StaticResource DashboardHeaderTitleStyle}" />

                    <Label
                        Text="Overview of your inspections"
                        Style="{StaticResource DashboardSubtitleStyle}" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource DashboardProfileButtonStyle}">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnOpenProfileClicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="Profile"
                        Style="{StaticResource DashboardProfileButtonLabelStyle}" />

                </Border>

            </Grid>


            <!-- ================= SUMMARY CARDS ================= -->

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="{StaticResource DashboardGridSpacing}"
                RowSpacing="{StaticResource DashboardGridSpacing}">

                <!-- Total -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource DashboardSummaryCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardSummaryCardContentStyle}">

                        <Label
                            Text="Total Inspections"
                            Style="{StaticResource DashboardSummaryTitleStyle}" />

                        <Label
                            Text="24"
                            Style="{StaticResource DashboardTotalMetricStyle}" />

                        <BoxView
                            Style="{StaticResource DashboardTotalIndicatorStyle}" />

                    </VerticalStackLayout>

                </Border>


                <!-- Pending -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource DashboardSummaryCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardSummaryCardContentStyle}">

                        <Label
                            Text="Pending"
                            Style="{StaticResource DashboardSummaryTitleStyle}" />

                        <Label
                            Text="8"
                            Style="{StaticResource DashboardPendingMetricStyle}" />

                        <BoxView
                            Style="{StaticResource DashboardPendingIndicatorStyle}" />

                    </VerticalStackLayout>

                </Border>


                <!-- In Progress -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource DashboardSummaryCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardSummaryCardContentStyle}">

                        <Label
                            Text="In Progress"
                            Style="{StaticResource DashboardSummaryTitleStyle}" />

                        <Label
                            Text="10"
                            Style="{StaticResource DashboardInProgressMetricStyle}" />

                        <BoxView
                            Style="{StaticResource DashboardInProgressIndicatorStyle}" />

                    </VerticalStackLayout>

                </Border>


                <!-- Completed -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource DashboardSummaryCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardSummaryCardContentStyle}">

                        <Label
                            Text="Completed"
                            Style="{StaticResource DashboardSummaryTitleStyle}" />

                        <Label
                            Text="6"
                            Style="{StaticResource DashboardCompletedMetricStyle}" />

                        <BoxView
                            Style="{StaticResource DashboardCompletedIndicatorStyle}" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ================= PRIORITY OVERVIEW ================= -->

            <VerticalStackLayout
                Spacing="{StaticResource DashboardSectionSpacing}">

                <Label
                    Text="Priority Overview"
                    Style="{StaticResource DashboardSectionTitleStyle}" />

                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Start">

                    <!-- High -->

                    <Border
                        Style="{StaticResource DashboardHighPriorityTagStyle}">

                        <Label
                            Text="High"
                            Style="{StaticResource DashboardHighPriorityLabelStyle}" />

                    </Border>


                    <!-- Medium -->

                    <Border
                        Style="{StaticResource DashboardMediumPriorityTagStyle}">

                        <Label
                            Text="Medium"
                            Style="{StaticResource DashboardMediumPriorityLabelStyle}" />

                    </Border>


                    <!-- Low -->

                    <Border
                        Style="{StaticResource DashboardLowPriorityTagStyle}">

                        <Label
                            Text="Low"
                            Style="{StaticResource DashboardLowPriorityLabelStyle}" />

                    </Border>

                </FlexLayout>

            </VerticalStackLayout>


            <!-- ================= TODAY'S INSPECTIONS ================= -->

            <VerticalStackLayout
                Spacing="{StaticResource DashboardInspectionSpacing}">

                <!-- Section Header -->

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Spacing="{StaticResource DashboardHeaderSpacing}">

                        <Label
                            Text="Today's Inspections"
                            Style="{StaticResource DashboardSectionTitleStyle}" />

                        <Label
                            Text="Your scheduled tasks"
                            Style="{StaticResource DashboardSectionSubtitleStyle}" />

                    </VerticalStackLayout>

                    <!-- View All -->

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource DashboardViewAllStyle}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnViewAllInspectionsClicked" />
                        </Border.GestureRecognizers>

                        <Label
                            Text="View All →"
                            Style="{StaticResource DashboardViewAllLabelStyle}" />

                    </Border>

                </Grid>


                <!-- ================= INSPECTION 1 ================= -->

                <Border
                    Style="{StaticResource DashboardInspectionCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardInspectionContentStyle}">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="{StaticResource DashboardHeaderSpacing}">

                                <Label
                                    Text="Building Safety Inspection"
                                    Style="{StaticResource DashboardInspectionTitleStyle}" />

                                <Label
                                    Text="Block A"
                                    Style="{StaticResource DashboardInspectionDetailStyle}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="9:00 AM"
                                Style="{StaticResource DashboardInspectionTimeStyle}" />

                        </Grid>


                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start">

                            <Border
                                Style="{StaticResource DashboardInspectionHighTagStyle}">

                                <Label
                                    Text="High Priority"
                                    Style="{StaticResource DashboardInspectionHighTagLabelStyle}" />

                            </Border>

                            <Border
                                Style="{StaticResource DashboardPendingStatusTagStyle}">

                                <Label
                                    Text="Pending"
                                    Style="{StaticResource DashboardPendingStatusTagLabelStyle}" />

                            </Border>

                        </FlexLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================= INSPECTION 2 ================= -->

                <Border
                    Style="{StaticResource DashboardInspectionCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardInspectionContentStyle}">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="{StaticResource DashboardHeaderSpacing}">

                                <Label
                                    Text="Equipment Inspection"
                                    Style="{StaticResource DashboardInspectionTitleStyle}" />

                                <Label
                                    Text="Block B"
                                    Style="{StaticResource DashboardInspectionDetailStyle}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="11:00 AM"
                                Style="{StaticResource DashboardInspectionTimeStyle}" />

                        </Grid>


                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start">

                            <Border
                                Style="{StaticResource DashboardInspectionMediumTagStyle}">

                                <Label
                                    Text="Medium Priority"
                                    Style="{StaticResource DashboardInspectionMediumTagLabelStyle}" />

                            </Border>

                            <Border
                                Style="{StaticResource DashboardInProgressStatusTagStyle}">

                                <Label
                                    Text="In Progress"
                                    Style="{StaticResource DashboardInProgressStatusTagLabelStyle}" />

                            </Border>

                        </FlexLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================= INSPECTION 3 ================= -->

                <Border
                    Style="{StaticResource DashboardInspectionCardStyle}">

                    <VerticalStackLayout
                        Style="{StaticResource DashboardInspectionContentStyle}">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="{StaticResource DashboardHeaderSpacing}">

                                <Label
                                    Text="Fire Safety Inspection"
                                    Style="{StaticResource DashboardInspectionTitleStyle}" />

                                <Label
                                    Text="Block C"
                                    Style="{StaticResource DashboardInspectionDetailStyle}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="2:00 PM"
                                Style="{StaticResource DashboardInspectionTimeStyle}" />

                        </Grid>


                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start">

                            <Border
                                Style="{StaticResource DashboardInspectionLowTagStyle}">

                                <Label
                                    Text="Low Priority"
                                    Style="{StaticResource DashboardInspectionLowTagLabelStyle}" />

                            </Border>

                            <Border
                                Style="{StaticResource DashboardCompletedStatusTagStyle}">

                                <Label
                                    Text="Completed"
                                    Style="{StaticResource DashboardCompletedStatusTagLabelStyle}" />

                            </Border>

                        </FlexLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>