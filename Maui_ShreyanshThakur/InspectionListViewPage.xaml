<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui_ShreyanshThakur.InspectionListListViewPage"
    Title="Inspections - ListView"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,*">

        <!-- Page Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="{StaticResource InspectionListPadding}"
            Spacing="{StaticResource SmallSpacing}">

            <Label
                Text="Inspections - ListView"
                FontFamily="PoppinsSemiBold"
                FontSize="{StaticResource InspectionListHeaderSize}"
                TextColor="{StaticResource PrimaryTextColor}" />

            <Label
                Text="The same inspection records using ListView"
                FontFamily="PoppinsRegular"
                FontSize="{StaticResource BodyFontSize}"
                TextColor="{StaticResource SecondaryTextColor}" />

        </VerticalStackLayout>

        <!-- ListView -->
        <ListView
            Grid.Row="1"
            x:Name="InspectionList"
            ItemsSource="{Binding Inspections}"
            HasUnevenRows="True"
            SeparatorVisibility="None"
            SelectionMode="Single"
            ItemSelected="OnItemSelected"
            Margin="{StaticResource InspectionListPadding}">

            <ListView.ItemTemplate>
                <DataTemplate>

                    <ViewCell>

                        <Border
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="{StaticResource BorderThickness}"
                            Padding="{StaticResource InspectionListCardPadding}"
                            Margin="{StaticResource InspectionListCardMargin}">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="{StaticResource InspectionListCornerRadius}" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="{StaticResource InspectionListSpacing}"
                                RowSpacing="{StaticResource InspectionListCardSpacing}">

                                <!-- Inspection Title -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Title}"
                                    FontFamily="PoppinsSemiBold"
                                    FontSize="{StaticResource InspectionListTitleSize}"
                                    TextColor="{StaticResource PrimaryTextColor}"
                                    VerticalOptions="Center" />

                                <!-- Status Badge -->
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="{StaticResource InspectionListStatusPadding}"
                                    BackgroundColor="{StaticResource PendingInspectionBackgroundColor}"
                                    StrokeThickness="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="{StaticResource InspectionListStatusCornerRadius}" />
                                    </Border.StrokeShape>

                                    <Border.Triggers>

                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Status}"
                                            Value="In Progress">

                                            <Setter
                                                Property="BackgroundColor"
                                                Value="{StaticResource InProgressInspectionBackgroundColor}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Status}"
                                            Value="Completed">

                                            <Setter
                                                Property="BackgroundColor"
                                                Value="{StaticResource CompletedInspectionBackgroundColor}" />
                                        </DataTrigger>

                                    </Border.Triggers>

                                    <Label
                                        Text="{Binding Status}"
                                        FontFamily="PoppinsSemiBold"
                                        FontSize="{StaticResource InspectionListMetaSize}"
                                        TextColor="{StaticResource PendingInspectionColor}">

                                        <Label.Triggers>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Status}"
                                                Value="In Progress">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource InProgressInspectionColor}" />
                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Status}"
                                                Value="Completed">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource CompletedInspectionColor}" />
                                            </DataTrigger>

                                        </Label.Triggers>
                                    </Label>

                                </Border>

                                <!-- Site -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Site, StringFormat='Site: {0}'}"
                                    FontFamily="PoppinsRegular"
                                    FontSize="{StaticResource InspectionListMetaSize}"
                                    TextColor="{StaticResource SecondaryTextColor}" />

                                <!-- Scheduled Date -->
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding ScheduledDate, StringFormat='{0:dd MMM yyyy}'}"
                                    FontFamily="PoppinsRegular"
                                    FontSize="{StaticResource InspectionListMetaSize}"
                                    TextColor="{StaticResource SecondaryTextColor}" />

                            </Grid>

                        </Border>

                    </ViewCell>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</ContentPage>
